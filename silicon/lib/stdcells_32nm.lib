/*
 * stdcells_32nm.lib -- synthetic single-corner standard-cell library
 * for the `silicon` open synthesis / place-and-route engines.
 *
 * Corner: ss 0.95 V 125 C (worst case), typical for a first timing closure.
 * Units: time 1ns, capacitance 1pF, leakage 1nW, area 1um^2.
 *
 * Tables are 3x3 NLDM: index_1 = input net transition (ns),
 *                     index_2 = output load (pF).
 * These numbers are representative of a small 32 nm educational PDK, not a
 * production library. Replace this file with yours; nothing else needs to
 * change as long as the cell names referenced in synth.py exist.
 */
library (stdcells_32nm) {
  delay_model : table_lookup;
  time_unit : "1ns";
  capacitive_load_unit (1, pF);
  voltage_unit : "1V";
  current_unit : "1mA";
  pulling_resistance_unit : "1kohm";
  leakage_power_unit : "1nW";
  nom_process : 1.0;
  nom_temperature : 125.0;
  nom_voltage : 0.95;
  corner : "ss_0p95V_125C";

  lu_table_template (delay_template) {
    variable_1 : input_net_transition;
    variable_2 : total_output_net_capacitance;
    index_1 ("0.010, 0.050, 0.100");
    index_2 ("0.001, 0.010, 0.020");
  }

  cell (INVX1) {
    area : 1.06;
    cell_leakage_power : 0.520;
    dont_touch : false ;
    pin (A) {
      direction : input;
      capacitance : 0.00120;
      max_transition : 0.4000;
    }
    pin (Y) {
      direction : output;
      max_capacitance : 0.0800;
      function : "out";
    }
    pin (Y) {
      direction : output;
      timing () {
        related_pin : "A";
        timing_sense : positive_unate;
        timing_type : combinational;
        cell_rise () {
          index_1 ("0.010, 0.050, 0.100");
          index_2 ("0.001, 0.010, 0.020");
          values ("0.0120, 0.0240, 0.0410",\
"0.0180, 0.0310, 0.0480",\
"0.0270, 0.0400, 0.0580");
        }
        cell_fall () {
          index_1 ("0.010, 0.050, 0.100");
          index_2 ("0.001, 0.010, 0.020");
          values ("0.0140, 0.0270, 0.0450",\
"0.0200, 0.0340, 0.0520",\
"0.0300, 0.0440, 0.0630");
        }
        rise_transition () {
          index_1 ("0.010, 0.050, 0.100");
          index_2 ("0.001, 0.010, 0.020");
          values ("0.0120, 0.0240, 0.0410",\
"0.0180, 0.0310, 0.0480",\
"0.0270, 0.0400, 0.0580");
        }
        fall_transition () {
